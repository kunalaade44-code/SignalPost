# ==============================================================================
# SIGNALPOST ENVIRONMENT CONFIGURATION (.env.example)
# Zero external accounts required: runs out of the box with SQLite and deterministic extraction.
# ==============================================================================

# Server & runtime
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (SQLite local default; Supabase optional)
DATABASE_URL=sqlite:///./signalpost.db
SUPABASE_URL=
SUPABASE_KEY=

# LLM provider (Optional: Mistral Free Tier. If empty, falls back to deterministic extraction at $0 cost)
LLM_PROVIDER=mistral
MODEL_NAME=mistral-small-latest
MISTRAL_API_KEY=

# Public registries (Brønnøysundregistrene open data, NLOD 2.0)
BRREG_ENHETER_BASE_URL=https://data.brreg.no/enhetsregisteret/api
BRREG_REGNSKAP_BASE_URL=https://data.brreg.no/regnskapsregisteret/regnskap
USER_AGENT=Signalpost-Agent/1.0 (+https://github.com/builderr-signalpost/signalpost; bot@signalpost.ai)

# Budget limits & compliance caps (100 companies benchmark)
MAX_REQUESTS_TOTAL=2000
MAX_COST_USD=10.0
MAX_RUN_TIME_SECONDS=2700
REQUEST_BUDGET_PER_COMPANY=18

# Cache settings
CACHE_ENABLED=true
CACHE_DIR=./cache
CACHE_TTL_DAYS_REGISTRY=7
CACHE_TTL_DAYS_WEBSITE=30
